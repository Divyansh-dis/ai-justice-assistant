# AI Justice Department Assistant - Backend Environment Configuration

# Optional: Google Gemini API Key for LLM generation
# If left empty, the built-in deterministic legal synthesis engine will be used.
GOOGLE_API_KEY=

# LLM Model Name (e.g., gemini-1.5-flash, gemini-2.0-flash)
LLM_MODEL=gemini-1.5-flash

# Database Configuration (Defaults to SQLite in backend directory)
DATABASE_URL=sqlite:///./app_data.db

# Vector Ingestion & Splitting Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4
